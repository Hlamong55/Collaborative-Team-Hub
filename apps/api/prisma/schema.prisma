generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaces      WorkspaceMember[]
  goals           Goal[]
  actionItems     ActionItem[]
  comments        Comment[]
  reactions       Reaction[]
  notifications   Notification[]
}

model Workspace {
  id          String   @id @default(uuid())
  name        String
  description String?
  color       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members        WorkspaceMember[]
  goals          Goal[]
  announcements  Announcement[]
  actionItems    ActionItem[]
}

model WorkspaceMember {
  id          String   @id @default(uuid())
  role        Role
  userId      String
  workspaceId String

  user        User      @relation(fields: [userId], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([userId, workspaceId])
}

enum Role {
  ADMIN
  MEMBER
}

model Goal {
  id          String   @id @default(uuid())
  title       String
  status      String
  dueDate     DateTime?
  ownerId     String
  workspaceId String

  owner       User      @relation(fields: [ownerId], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  milestones  Milestone[]
  updates     Comment[]
  actionItems ActionItem[]

  createdAt   DateTime @default(now())
}

model Milestone {
  id        String   @id @default(uuid())
  title     String
  progress  Int
  goalId    String

  goal      Goal @relation(fields: [goalId], references: [id])
}

model Announcement {
  id          String   @id @default(uuid())
  content     String
  pinned      Boolean  @default(false)
  workspaceId String

  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  comments    Comment[]

  createdAt   DateTime @default(now())
}

model ActionItem {
  id          String   @id @default(uuid())
  title       String
  status      String
  priority    String
  dueDate     DateTime?
  assigneeId  String
  goalId      String?
  workspaceId String

  assignee    User      @relation(fields: [assigneeId], references: [id])
  goal        Goal?     @relation(fields: [goalId], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  createdAt   DateTime @default(now())
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  userId    String
  goalId    String?
  announcementId String?

  user      User @relation(fields: [userId], references: [id])
  goal      Goal? @relation(fields: [goalId], references: [id])
  announcement Announcement? @relation(fields: [announcementId], references: [id])

  reactions Reaction[]

  createdAt DateTime @default(now())
}

model Reaction {
  id        String   @id @default(uuid())
  emoji     String
  userId    String
  commentId String

  user      User    @relation(fields: [userId], references: [id])
  comment   Comment @relation(fields: [commentId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  message   String
  userId    String
  read      Boolean  @default(false)

  user      User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

model ActivityLog {
  id          String   @id @default(uuid())
  action      String
  userId      String
  workspaceId String

  createdAt   DateTime @default(now())
}